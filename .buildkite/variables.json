[
  {
    "key": "clone-server",
    "label": ":github: clone SERVER :computer:",
    "commands": ["git clone https://github.com/polar-bookstore/http-server.git http-server", "cd http-server && pwd && ls -la", "echo \"AWS_REGION: $${AWS_REGION}\""],
    "plugins": [
      { "name": "cache#v1.1.0", "path": "http-server", "restore": "pipeline", "save": "pipeline" }
    ],
  },
  {
    "key": "clone-ui",
    "label": ":github: clone UI :spider_web:",
    "commands": ["git clone https://github.com/polar-bookstore/http-server.git ui", "cd ui && pwd && ls -la", "echo \"AWS_REGION: $${AWS_REGION}\""],
    "plugins": [
      { "name": "cache#v1.1.0", "path": "ui", "restore": "pipeline", "save": "pipeline" }
    ],
  },
  {
    "key": "clone-catalog",
    "label": ":github: clone CATALOG :books:",
    "commands": ["git clone https://github.com/polar-bookstore/http-server.git catalog", "cd catalog && pwd && ls -la", "echo \"AWS_REGION: $${AWS_REGION}\""],
    "plugins": [
      { "name": "cache#v1.1.0", "path": "catalog", "restore": "pipeline", "save": "pipeline" }
    ],
  }
]
